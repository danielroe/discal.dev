# Session encryption (min 32 chars)
NUXT_SESSION_PASSWORD=

# Discord OAuth (for user login)
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=

# Discord Bot Token (for REST API calls to fetch events)
NUXT_DISCORD_BOT_TOKEN=

# Public
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_DISCORD_CLIENT_ID=

# Redis KV store (production only — dev uses fs driver)
KV_REST_API_URL=
KV_REST_API_TOKEN=
